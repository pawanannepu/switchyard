{
  "name": "switchyard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @switchyard/desktop build",
    "dev": "cargo build -p sy-daemon --features devtools && pnpm --filter @switchyard/desktop tauri dev",
    "tauri": "pnpm --filter @switchyard/desktop tauri",
    "app:build": "node scripts/build-engine.mjs --release --universal && pnpm --filter @switchyard/desktop tauri build --target universal-apple-darwin --config src-tauri/tauri.bundle.conf.json",
    "app:build:devtools": "SWITCHYARD_DEVTOOLS=1 pnpm app:build",
    "engine:build": "node scripts/build-engine.mjs",
    "devbridge": "cargo run -q -p sy-devbridge --",
    "protocol:gen": "pnpm --filter @switchyard/protocol generate",
    "protocol:check": "pnpm --filter @switchyard/protocol check",
    "boundaries:check": "node scripts/check-boundaries.mjs",
    "release:check": "node scripts/release-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "lefthook": "2.2.2",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
